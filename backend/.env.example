DATABASE_URL=postgres://ggtix:ggtixpassword@localhost:5432/ggtix_db
# JWT_SECRET must be at least 32 characters (app fails to boot otherwise)
JWT_SECRET=super-secret-key-gg-tix-dev-2026
PORT=3000

# CORS whitelist (comma-separated origins). Dev origins are auto-added in non-production.
CORS_ORIGINS=http://localhost:3001

# Rate limiting (SEC-01)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ORDER_MAX=20

# Request body size limit in bytes, default 10 MB
# (multipart /api/uploads bypasses this; its cap is IMAGE_MAX_BYTES)
BODY_SIZE_LIMIT=10485760

# JWT TTLs (SEC-03)
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d

# Backblaze B2 object storage,required, app fails to boot otherwise
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
# Max upload file size in bytes, default 10 MB
IMAGE_MAX_BYTES=10485760

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false